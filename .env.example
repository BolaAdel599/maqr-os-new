# Database (Neon/Postgres)
DATABASE_URL=
DIRECT_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Cron (must be set in production - the check-subscriptions cron rejects requests without it)
CRON_SECRET=

# Paymob (payment webhook rejects everything if this is missing)
PAYMOB_HMAC=
# Paymob payment initiation (used by /api/payment/paymob/create to start a checkout)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# Pusher (real-time). If left unset, kitchen/cashier/driver pages fall back to polling every few seconds.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# WhatsApp Cloud API (Meta). If left unset, messages are only logged to the console.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Cloudflare R2 (menu item image uploads). If left unset, /api/upload will error clearly instead of silently no-op-ing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Driver delivery fee added to a driver's earnings per completed delivery (optional, defaults to 20)
DRIVER_DELIVERY_FEE=20
